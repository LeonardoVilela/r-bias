{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rbias/response_record.schema.json",
  "title": "R-BIAS response record",
  "type": "object",
  "required": [
    "scenario_id",
    "prompt_id",
    "category",
    "regime",
    "racial_group",
    "prompt_text",
    "response_text",
    "sample_index",
    "model_name",
    "model_version",
    "provider",
    "temperature",
    "top_p",
    "max_tokens",
    "timestamp",
    "status",
    "error_message"
  ],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "prompt_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "regime": {"enum": ["strict", "implicit_signaling"]},
    "racial_group": {"enum": ["preto", "branco", "pardo", "indígena", "amarelo"]},
    "source_racial_group": {
      "enum": ["negro/preto", "branco", "pardo", "indigena", "asiatico/amarelo"]
    },
    "prompt_text": {"type": "string", "minLength": 1},
    "response_text": {"type": "string"},
    "sample_index": {"type": "integer", "minimum": 0},
    "model_name": {"type": "string", "minLength": 1},
    "model_version": {"type": ["string", "null"]},
    "provider": {"type": "string", "minLength": 1},
    "temperature": {"type": "number", "minimum": 0},
    "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "max_tokens": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "error"]},
    "error_message": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {
        "properties": {
          "response_text": {"minLength": 1},
          "error_message": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "error"}}},
      "then": {
        "properties": {
          "error_message": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}

